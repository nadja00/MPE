#include <LiquidCrystal.h>

#define SELECT 1
#define LEFT 2
#define UP 3
#define DOWN 4
#define RIGHT 5

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

byte smajli[8] = {
  B00000,
  B01010,
  B00000,
  B00100,
  B00000,
  B10001,
  B10001,
  B01110
};

int xPos = 0;
int yPos = 0;
bool dozvola = true;

void setup() {
  lcd.begin(16, 2);
  lcd.createChar(0, smajli);  
}

void loop() {
  byte button;

  lcd.setCursor(xPos, yPos);
  lcd.write(byte(0));

  button = readButton();

  if (button == RIGHT && dozvola == 1) {
    if (xPos < 15) xPos++;
    lcd.clear();
    dozvola = false;
  }
  else if (button == LEFT && dozvola == 1) {
    if (xPos > 0) xPos--;
    lcd.clear();
    dozvola = false;
  }
  else if (button == UP && dozvola == 1) {
    if (yPos == 1) yPos--;
    lcd.clear();
    dozvola = false;
  }
  else if (button == DOWN && dozvola == 1) {
    if (yPos == 0) yPos++;
    lcd.clear();
    dozvola = false;
  }
  else if (button != RIGHT && button != LEFT && button != DOWN && button != UP) {
    dozvola = true;
  }
}

byte readButton() {
  int tmp = analogRead(0); //read value of Analog input 0

  if (tmp > 635 && tmp < 645) 
      return SELECT;
  if (tmp > 405 && tmp < 415) 
      return LEFT;
  if (tmp > 95  && tmp < 105) 
      return UP;
  if (tmp > 252 && tmp < 262) 
      return DOWN;
  if (tmp < 5)                
      return RIGHT;

  return 0; //NONE
}
